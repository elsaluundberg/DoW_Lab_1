@model PlaylistApp.Models.Song

@{
    ViewData["Title"] = "Låtdetaljer";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <p class="text-muted">Detaljerad information om den valda låten.</p>

    @if (Model != null)
    {
        <div class="card col-md-6 shadow-sm mt-4">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">🎵 @Model.Name</h4>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item">
                        <strong>Låt-ID:</strong> @Model.Id
                    </li>
                    <li class="list-group-item">
                        <strong>Artist:</strong> @Model.ArtistName
                    </li>
                    <li class="list-group-item">
                        <strong>Album:</strong> @Model.AlbumName
                    </li>
                    <li class="list-group-item">
                        <strong>Längd:</strong> 
                        @Model.Length sekunder 
                        <span class="badge bg-info text-dark ms-2">
                            (@(Model.Length / 60) min @(Model.Length % 60) sek)
                        </span>
                    </li>
                </ul>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                        ← Tillbaka till låtlistan
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Kunde inte hitta några detaljer för den angivna låten.
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Tillbaka till listan</a>
    }
</div>