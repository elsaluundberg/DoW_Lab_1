@model List<PlaylistApp.Models.Song>

@{
    ViewData["Title"] = "Låtlista";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <!-- 1. Visar data skickad via ViewBag -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info">
            @ViewBag.Message
        </div>
    }

    <!-- 2. Visar data skickad via ViewData -->
    <p><strong>Totalt antal låtar i listan:</strong> @ViewData["TotalSongsCount"] st</p>

    <!-- Länk till formulärvyn för att lägga till ny låt -->
    <div class="mb-3">
        <a asp-controller="Home" asp-action="Create" class="btn btn-primary">
            + Lägg till ny låt
        </a>
    </div>

    <!-- 3. Visar data från den starkt typade modellen (List<Song>) -->
    <h3>Dina Låtar</h3>
    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Låtnamn</th>
                    <th>Längd</th>
                    <th>Artist</th>
                    <th>Album</th>
                    <th>Detaljer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var song in Model)
                {
                    <tr>
                        <td>@song.Id</td>
                        <td>@song.Name</td>
                        <td>@song.Length sek (@(song.Length / 60) m @(song.Length % 60) s)</td>
                        <td>@song.ArtistName</td>
                        <td>@song.AlbumName</td>
                        <td>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@song.Id" class="btn btn-sm btn-outline-info">
                                Visa detaljer
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Inga låtar finns i listan ännu.</p>
    }
</div>